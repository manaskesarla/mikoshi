# Copy to .env and fill in. Never commit .env.
VLM_MODE=mock            # mock | gemini
GEMINI_API_KEY=          # only for VLM_MODE=gemini
VLM_MODEL=               # required for gemini; check Google's current model list
MIKOSHI_API_KEY=         # shared secret the extension sends as X-Mikoshi-Key (empty = no auth, dev only)
MIKOSHI_CANARIES=        # comma-separated canary strings; requests containing one are rejected
